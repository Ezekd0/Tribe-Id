NODE_ENV=development
HOST=127.0.0.1
PORT=3001
APP_ORIGIN=http://localhost:5173
# Optional packaged same-origin admin; API-only when blank.
ADMIN_WEB_DIST=
# Set your own PostgreSQL connection URL; no credentials are supplied.
DATABASE_URL=
# Authentication delivery.
MAIL_FROM=
SMTP_URL=
# Opt-in development-only illustrative API data. Forbidden with NODE_ENV=production.
ENABLE_MEMBER_PREVIEW=false
# Web preview must also be explicitly enabled, only in the Vite development server:
VITE_MEMBER_PREVIEW=false

# Public non-secret mobile API address; HTTPS is required for release.
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_APP_ENV=development
# Optional explicit membership selection; otherwise the app presents a chooser.
EXPO_PUBLIC_TRIBE_ID=

DB_POOL_MAX=10
# Only actual load-balancer IP/CIDR ranges; never trust all forwarded headers.
TRUSTED_PROXY_CIDRS=

# Enable only with a migrated DB and real delivery configuration. No secrets supplied.
AUTH_ENABLED=false
# External authentication email requires a separately approved send window.
# False keeps the scheduled worker from contacting SMTP; loopback test capture is separate.
AUTH_MAIL_DELIVERY_ENABLED=false
# Canonical base64 of independently generated 32-byte secret keys.
AUTH_ENCRYPTION_KEY=
AUTH_RATE_LIMIT_KEY=
# smtp (TLS worker) or explicit development-only local-capture.
# local-capture requires credential-free loopback SMTP, e.g. smtp://127.0.0.1:1025.
AUTH_MAIL_MODE=smtp
# SMTP_URL: smtps://... or smtp://...?requireTLS=true; credentials managed by deployment.
# Schedule npm run auth:mail for durable delivery; do not log its encrypted payloads.
# Required for AUTH_ENABLED=true in production: maintained local common/compromised-password list,
# one password per line (1000+ entries, maximum 10 MiB). No external lookup or secret upload.
AUTH_PASSWORD_BLOCKLIST_PATH=
# Optional cleanup policy: auth audit deletion is disabled unless retention is explicitly configured.
AUTH_AUDIT_RETENTION_DAYS=

# Server-only private Cloudflare R2; leave all four empty to disable portraits.
# Create a private EU-jurisdiction bucket separately after authorization.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_JURISDICTION=eu

# Explicit one-shot informational worker only; API startup never sends push.
# Keep disabled until provider setup and bounded external testing are approved.
PUSH_DELIVERY_ENABLED=false
INFORMATIONAL_EMAIL_ENABLED=false
EXPO_ACCESS_TOKEN=
# Run compiled operations/push-worker.js using the reviewed image and scheduler.
# Native project ID belongs in Expo extra.eas.projectId; never put this server token in Expo.
